# ─────────────────────────────────────────────────────────────────────────────
# KrishiMitra backend — environment variables (EXAMPLE / template)
#
# Copy this file to  backend/.env  and fill in real values:
#     Windows (cmd):   copy .env.example .env
#     PowerShell:      Copy-Item .env.example .env
#     macOS / Linux:   cp .env.example .env
#
# backend/.env is gitignored and must NEVER be committed.
# Every variable below is OPTIONAL for the server to BOOT — a missing value only
# disables the one feature that needs it; the Django server still starts.
# Do not put real secrets in this example file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core / security ──────────────────────────────────────────────────────────
# Django secret key. An insecure dev fallback is used if this is unset; set a
# long random value for any shared or production environment.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# "1" = debug on (development), "0" = debug off (production).
DJANGO_DEBUG=1

# ── AI: Google Gemini (live disease detection & AI recommendations) ──────────
# REST API key from Google AI Studio. If empty, Gemini-backed features return a
# graceful "unavailable" response instead of crashing.
GEMINI_API_KEY=

# ── AI: Ollama (optional local LLM; NOT required for startup) ────────────────
# Base URL of a running Ollama server. Contacted lazily for AI Mitra chat stream.
# If Ollama is offline, the backend automatically falls back to Gemini / ChromaDB.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# ── RAG / vector store (ChromaDB) ────────────────────────────────────────────
# Absolute path to the persistent Chroma store. LEAVE THIS COMMENTED OUT to use
# the default (backend/knowledge-base/chroma_db). Do not set it to an empty
# value — an empty string would override the default with "".
# Regenerate the collections with the scripts in backend/knowledge-base/scripts/.
# CHROMA_DB_PATH=C:\path\to\chroma_db

# ── Market data (data.gov.in mandi prices) ───────────────────────────────────
# API key from https://data.gov.in. Without it, the market-price sync is skipped.
DATAGOV_API_KEY=

# ── Email (password-reset OTP via SMTP) ──────────────────────────────────────
# Defaults target Gmail SMTP. Leave user/password empty to disable email sending.
# (Do not set EMAIL_PORT to an empty value — it is parsed with int().)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Advanced / rarely needed ─────────────────────────────────────────────────
# Set to "1" to skip importing TensorFlow (only relevant if TF is installed).
DISABLE_TENSORFLOW_IMPORT=0
